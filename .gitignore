# Dart / Flutter
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
build/
# pubspec.lock は追跡する。Dart Pub Workspace はルートに全パッケージ共通の
# lock を生成するため、除外すると CI と開発環境で推移的依存が食い違いうる。
.pub-cache/
.pub/

# Melos / pub workspaces
pubspec_overrides.yaml
melos_*.iml

# IDE
.idea/
*.iml
.vscode/

# macOS
.DS_Store

# Platform build artifacts (native scaffolds are source-only in this repo)
**/android/.gradle/
**/android/local.properties
**/ios/Pods/
**/ios/.symlinks/
**/macos/Pods/
# Flutter が生成する成果物。絶対パス(/Users/...)やローカル symlink を含むため
# 追跡してはならない。`flutter build` / `pod install` が毎回再生成する。
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/ios/Runner/GeneratedPluginRegistrant.*
**/macos/Flutter/ephemeral/
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/

# 一時設計ノート
.tmp/
