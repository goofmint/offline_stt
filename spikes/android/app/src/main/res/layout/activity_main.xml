<?xml version="1.0" encoding="utf-8"?>
<!--
  単一 Activity の検証ハーネス UI。spikes/web/index.html の
  「ボタン + 逐次ログ表示領域」方針を踏襲する (info/ok/ng/warn の色分けは Logcat 側で行い、
  画面上は時系列テキストとして表示する)。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/text_env"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="環境情報を読み込み中..."
        android:textIsSelectable="true"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_check_basic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Basic 状態確認" />

        <Button
            android:id="@+id/btn_run_basic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Basic 認識実行" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_run_advanced"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Advanced フォールバック検証" />

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="実行中セッションをキャンセル" />

        <Button
            android:id="@+id/btn_probe_platform"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="代替案調査: 標準SpeechRecognizer" />

        <Button
            android:id="@+id/btn_probe_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="代替案: ja-JP取得 + ファイル入力検証" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_probe_platform_abc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="代替案検証 A+B+C: 言語DL+ファイル入力+精度" />

    <TextView
        android:id="@+id/text_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="結果: (未実行)"
        android:textIsSelectable="true"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/text_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text=""
            android:textIsSelectable="true"
            android:textSize="10sp" />
    </ScrollView>

</LinearLayout>
