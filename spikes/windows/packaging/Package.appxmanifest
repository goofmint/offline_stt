<?xml version="1.0" encoding="utf-8"?>
<!--
  Package.appxmanifest — systemAIModels capability 宣言「あり」版。

  対応 Issue: #15-18 全般。design.md §4.4「MSIX + systemAIModels はアプリ側要件」、
  requirements.md §8「Windows: MSIXパッケージ化 + Package.appxmanifest に
  systemAIModels capability宣言、MaxVersionTested を 10.0.26226.0 以降に設定」。

  次の3点はMicrosoft公式ドキュメントで文言そのものを確認済み(2026-09-20
  WebFetch、https://learn.microsoft.com/en-us/windows/ai/apis/get-started の
  「Edit the Package.appxmanifest file」節):
    1. xmlns:systemai="http://schemas.microsoft.com/appx/manifest/systemai/windows10"
       をルート要素の名前空間宣言に追加すること
    2. IgnorableNamespaces に "systemai" を含めること
    3. <Capabilities> 内に <systemai:Capability Name="systemAIModels"/> を追加すること
    4. <TargetDeviceFamily> の MaxVersionTested を 10.0.26226.0 以上にすること

  一方、以下は本スパイクの構成(WinUIやWPFではない、素のWin32コンソールEXEを
  Desktop Bridge方式でMSIX化する構成)に合わせて追加した一般的なDesktop
  Bridgeマニフェストの定型部分であり、Microsoft公式ドキュメントの
  Windows AI APIsページはWinUI3/WPF/WinFormsの例しか示していないため、
  「素のコンソールEXE + Windows.FullTrustApplication + runFullTrust」と
  systemAIModelsの組み合わせ自体は公式に確認されていない(要確認。README参照)。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:systemai="http://schemas.microsoft.com/appx/manifest/systemai/windows10"
  IgnorableNamespaces="uap rescap systemai">

  <Identity
    Name="MoonGift.OfflineSttWindowsSpike"
    Publisher="CN=MOONGIFT-OfflineSTT-Spike-SelfSigned"
    Version="0.0.1.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Windows STT Spike (with systemAIModels)</DisplayName>
    <PublisherDisplayName>MOONGIFT</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="WindowsSTTSpikeCli.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Windows STT Spike"
        Description="M0 Windows Speech Recognition spike (Issue #15-18)"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Desktop Bridge(素のWin32 EXEをMSIX化)の定型capability。 -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Issue #18: この行の有無で挙動がどう変わるかを検証する。
         対比用に Package.NoCapability.appxmanifest ではこの行を削除している。 -->
    <systemai:Capability Name="systemAIModels" />
  </Capabilities>
</Package>
