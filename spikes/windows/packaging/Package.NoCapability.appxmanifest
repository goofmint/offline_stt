<?xml version="1.0" encoding="utf-8"?>
<!--
  Package.NoCapability.appxmanifest — systemAIModels capability 宣言「なし」版。

  Issue #18 の対比実験専用。Package.appxmanifest との差分は
  systemai 名前空間宣言・IgnorableNamespacesへの追加・<systemai:Capability>要素の
  3点をすべて取り除いていることのみ。

  使い方: パッケージングプロジェクト(packaging/WindowsSTTSpikePackage.wapproj)の
  参照するマニフェストをこのファイルに差し替えて別名でMSIX生成し、
  `windows-stt-spike capability-check` を実行して Package.appxmanifest 版との
  差分(CapabilityMissing / hresult_access_denied が発生するかどうか)を
  RESULTS.md に記録する(README「systemAIModels capabilityを宣言しないとどうなるか」
  参照)。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="MoonGift.OfflineSttWindowsSpike.NoCapability"
    Publisher="CN=MOONGIFT-OfflineSTT-Spike-SelfSigned"
    Version="0.0.1.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Windows STT Spike (without systemAIModels)</DisplayName>
    <PublisherDisplayName>MOONGIFT</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="WindowsSTTSpikeCli.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Windows STT Spike (No Capability)"
        Description="M0 Windows Speech Recognition spike - capability declaration omitted for Issue #18 comparison"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- systemAIModels は意図的に宣言していない(Issue #18対比実験)。 -->
  </Capabilities>
</Package>
