<?xml version="1.0" encoding="utf-8"?>
<!--
  WindowsSTTSpikePackage.wapproj

  WindowsSTTSpikeCli.vcxproj(素のWin32コンソールEXE)をMSIXパッケージ化するための
  "Windows Application Packaging Project"(Desktop Bridge方式)。

  要確認(最重要): 本ファイルはWindows機を持たない環境で手書きしたものであり、
  一度もVisual Studio / msbuildで開けていない。Windows Application Packaging
  Projectは通常Visual Studioの「新しいプロジェクト」ウィザードから生成され、
  ウィザードが内部的に付与する詳細設定(正確なGUID体系、
  Microsoft.AppXPackage.Targetsのインポート条件、Nuget復元との相互作用等)を
  本ファイルが完全に再現できているかは検証できていない。README「ビルド方法」の
  「Visual Studioが無い環境でもビルドできるか」の節も参照。
  実機で開けない場合は、Visual Studioで新規に
  「Windows Application Packaging Project」を作成し、Applications配下に
  WindowsSTTSpikeCli.vcxprojへの参照を追加し、Package.appxmanifestを
  packaging/Package.appxmanifest の内容で上書きする方法に切り替えること。
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{9A2C7E1D-4F3B-4A9C-8E5D-2B6F7C1A9D33}</ProjectGuid>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <DefaultLanguage>ja-JP</DefaultLanguage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <!-- ローカル検証用はサイドロード(未署名 or 自己署名)で行う想定。
         README「MSIXの署名について」参照(要確認事項)。 -->
    <EntryPointProjectUniqueName>..\WindowsSTTSpikeCli.vcxproj</EntryPointProjectUniqueName>
    <AppxBundle>Never</AppxBundle>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
  </PropertyGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowsSTTSpikeCli.vcxproj">
      <Private>True</Private>
      <ReferenceOutputAssembly>True</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <PropertyGroup>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">17.0</VisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
  </PropertyGroup>

  <!-- Windows Application Packaging Project の中核ターゲット。
       Visual Studio + "Universal Windows Platform development"
       ワークロード(またはWindows SDKの対応コンポーネント)導入時に
       このパスへ配置される(要確認: 正確な配置パス・必要な個別コンポーネントは
       VSバージョンにより変わる可能性がある)。 -->
  <Import Project="$(VSToolsPath)\AppxPackage\Microsoft.AppXPackage.Targets"
          Condition="'$(VSToolsPath)' != ''" />
</Project>
