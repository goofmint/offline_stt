<?xml version="1.0" encoding="utf-8"?>
<!--
  apps/example を MSIX パッケージ化するための Package.appxmanifest(Issue #59)。

  このファイルは `flutter create` の生成物ではない。Flutter の Windows アプリは
  既定で「パッケージ化されていない Win32 アプリ」としてビルドされ、
  `flutter build windows` は MSIX を生成しないため、MSIX 化に必要なマニフェストは
  リポジトリ側で用意する必要がある。手順は同ディレクトリの README.md、
  および packages/offline_stt_windows/README.md を参照。

  **このマニフェストで MSIX を生成し、インストールして動かすところまでは
  一度も実施していない**(本リポジトリに Windows 実機が無い。Issue #58)。
  内容は公式ドキュメントと spikes/windows/packaging/Package.appxmanifest を
  根拠に書いたものであり、検証済みではない。

  systemAIModels capability まわりの3点は Microsoft 公式ドキュメント
  (https://learn.microsoft.com/en-us/windows/ai/apis/get-started の
  「Edit the Package.appxmanifest file」節、および
  https://learn.microsoft.com/en-us/windows/ai/apis/speech-recognition)で
  文言そのものを確認している:
    1. xmlns:systemai="http://schemas.microsoft.com/appx/manifest/systemai/windows10"
       をルート要素へ追加する
    2. IgnorableNamespaces に "systemai" を含める
    3. <Capabilities> に <systemai:Capability Name="systemAIModels"/> を追加する
    4. <TargetDeviceFamily> の MaxVersionTested を 10.0.26226.0 以降にする。
       古い値のままだと、モデル読み込み時に "Not declared by app" エラーになる

  Identity / Publisher はサイドロード用の自己署名証明書のサブジェクトと
  完全一致させる必要がある。ここに書いてある値はプレースホルダであり、
  実際に署名する証明書に合わせて書き換えること(README.md 参照)。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:systemai="http://schemas.microsoft.com/appx/manifest/systemai/windows10"
  IgnorableNamespaces="uap rescap systemai">

  <Identity
    Name="MoonGift.OfflineSttExample"
    Publisher="CN=MOONGIFT-OfflineSTT-Example-SelfSigned"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>offline_stt example</DisplayName>
    <PublisherDisplayName>MOONGIFT</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- MaxVersionTested は 10.0.26226.0 以上にする(上記コメントの4番)。
         MinVersion 自体は 10.0.17763.0 のままでよい(公式ドキュメントの例が
         そうなっている)が、offline_stt_windows が実際に動作するのは
         requirements.md NFR-4 のとおり Windows 11 24H2 (build 26100) 以降で
         あり、それ未満では checkModel() が unavailable を返す。 -->
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <!-- Flutter の Windows ランナーは素の Win32 EXE である。これを MSIX に
         収める方式が Desktop Bridge であり、EntryPoint は
         Windows.FullTrustApplication、capability は runFullTrust になる。
         Executable は windows/CMakeLists.txt の BINARY_NAME(= example)に
         由来する example.exe である。 -->
    <Application Id="App" Executable="example.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="offline_stt example"
        Description="offline_stt の参照実装 example app(Windows / MSIX)"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Desktop Bridge(Win32 EXE の MSIX 化)の定型 capability。 -->
    <rescap:Capability Name="runFullTrust" />
    <!-- これが無いと Windows AI のモデルへアクセスできない。
         公式ドキュメントは AIFeatureReadyState.CapabilityMissing の説明として
         「EnsureReadyAsync and CreateAsync will throw
          winrt::hresult_access_denied (add the systemAIModels capability to
          the app manifest)」と記している。offline_stt_windows はこの
         E_ACCESSDENIED を platformError として写像し、原因をメッセージに
         含める(windows/windows_transcribe_error.cpp)。 -->
    <systemai:Capability Name="systemAIModels" />
  </Capabilities>
</Package>
